<?xml version="1.0"?>
<package format="3">
  <name>billiebot_tests</name>
  <version>0.1.0</version>
  <description>Discrete verification scripts for BillieBot MVP bring-up.</description>
  <maintainer email="billiebot@example.com">BillieBot Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>billiebot_msgs</depend>
  <depend>billiebot_summary</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>python3-yaml</exec_depend>

  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
