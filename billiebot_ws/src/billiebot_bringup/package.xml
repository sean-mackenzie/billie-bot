<?xml version="1.0"?>
<package format="3">
  <name>billiebot_bringup</name>
  <version>0.1.0</version>
  <description>Integrated launch files for BillieBot MVP bring-up.</description>
  <maintainer email="billiebot@example.com">BillieBot Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>billiebot_audio</exec_depend>
  <exec_depend>billiebot_control</exec_depend>
  <exec_depend>billiebot_description</exec_depend>
  <exec_depend>billiebot_logging</exec_depend>
  <exec_depend>billiebot_navigation</exec_depend>
  <exec_depend>billiebot_perception</exec_depend>
  <exec_depend>billiebot_safety</exec_depend>
  <exec_depend>billiebot_state</exec_depend>
  <exec_depend>billiebot_summary</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
