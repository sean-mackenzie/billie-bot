<?xml version="1.0"?>
<package format="3">
  <name>billiebot_perception</name>
  <version>0.1.0</version>
  <description>Visual perception nodes for BillieBot.</description>
  <maintainer email="billiebot@example.com">BillieBot Maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>billiebot_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>image_transport</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
